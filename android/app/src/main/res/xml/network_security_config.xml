<?xml version="1.0" encoding="utf-8"?>
<!--
  O servidor e servido via Pangolin com HTTPS (Let's Encrypt), entao o padrao
  seguro (cleartext BLOQUEADO) e mantido para todo o app.

  Se um dia voce quiser apontar o app direto para o Flask na LAN por HTTP
  (sem passar pelo Pangolin), adicione um <domain-config cleartextTrafficPermitted="true">
  com o IP/host local. Deixado comentado de proposito.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.10</domain>
    </domain-config>
    -->
</network-security-config>
