*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Database (generated by build.py)
data/*.db
!data/price-history.db

# Legacy: filament.db must live in data/ (via DB_PATH), never at the repo root.
# A stale root-level copy previously broke the price collector validation.
/filament.db

# Inventory database (user data, created/managed at runtime by the app)

# Price intelligence database: historical data is persistent and may be versioned.
# Keep the live price-history.db tracked when present; never delete it automatically.

# Database backups (created at runtime by update-server.sh)
backups/

# Local config (machine-specific paths/port). Use config.env.example as template.
config.env

# Build info (written at runtime by update-server.sh)
build-info.env

# Creality Print exports: versionados propositalmente para que quem clona o
