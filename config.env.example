# config.env.example — modelo de configuração do FilamentDB.
#
# Copie para config.env e ajuste conforme a máquina:
#     cp config.env.example config.env
#
# O config.env real NÃO é versionado (está no .gitignore), pois contém paths e
# porta específicos do ambiente. É a FONTE ÚNICA DE VERDADE consumida por:
#   - app Flask / build.py  → via src/config.py
#   - run.sh / update-server.sh / publish.sh → via `source config.env`
#   - systemd → via EnvironmentFile=-/srv/FilamentDB/config.env
#
# Precedência: variável já no ambiente do processo > config.env > default do código.
# Formato: KEY=VALUE (compatível com `source` do shell e EnvironmentFile do systemd).

# Caminho do banco de catálogo (regenerado por build.py a partir dos YAMLs).
FILAMENT_DB_PATH=/srv/FilamentDB/filament.db

# Caminho do banco de estoque (dado mutável do usuário — NUNCA regenerado).
FILAMENT_INVENTORY_DB_PATH=/srv/FilamentDB/inventory.db

# Diretório dos backups (binário + dump JSON), com rotação. Fora do git.
FILAMENTDB_BACKUP_DIR=/srv/FilamentDB/backups

# Arquivo com a data/commit da última atualização bem-sucedida (escrito pelo
# update-server.sh, lido pela UI via /api/build-info). Fora do git.
FILAMENTDB_BUILD_INFO_PATH=/srv/FilamentDB/build-info.env

# Porta HTTP do serviço.
PORT=5000

# ─── Autorização (escrita de estoque) ────────────────────────────────────────
# Feature flag mestra. 0/off = sistema aberto (usuário exibido como "guest").
# 1/on = escrita exige identidade na allowlist abaixo.
FILAMENTDB_AUTH_ENABLED=0

# Allowlist de quem pode ALTERAR o estoque (CSV de e-mails/usuários).
# Ex.: FILAMENTDB_WRITERS=rafael@exemplo.com,outro@exemplo.com
FILAMENTDB_WRITERS=

# Header de identidade injetado pelo Pangolin. Para identificar por e-mail use
# Remote-Email (Pangolin também envia Remote-User, Remote-Name, Remote-Role).
# Ref: docs.pangolin.net/manage/access-control/forwarded-headers
FILAMENTDB_IDENTITY_HEADER=Remote-Email

# Segredo compartilhado proxy↔Flask (defesa contra header forjado). Se vazio,
# o gate NÃO verifica origem (inseguro — só aceitável se o Flask estiver
# isolado em rede interna). Ver o aviso de segurança no cabeçalho de src/auth.py.
FILAMENTDB_PROXY_SECRET=

# Modo dev: 1 libera escrita mesmo com auth ligada e sem header. NUNCA em produção.
FILAMENTDB_DEV_OPEN=0
